# ============================================================
# AISOC configuration
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. NEVER commit or share real keys.
# ============================================================

# --- General ---
ENVIRONMENT=dev
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./aisoc.db
# PostgreSQL (when using docker-compose):
# DATABASE_URL=postgresql+psycopg://aisoc:aisoc@localhost:5432/aisoc
CORS_ORIGINS=["http://localhost:5173"]

# --- CrowdStrike Falcon ---
# true  = use built-in sample alerts, no calls to your tenant
# false = use the real Falcon API (requires the keys below)
FALCON_MOCK=true
FALCON_BASE_URL=
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=
# Cloud region: us1 | us2 | eu1 | usgov1
FALCON_CLOUD=us1
# Or explicit full base URL (e.g., https://api.crowdstrike.com or https://api.us-2.crowdstrike.com)
FALCON_BASE_URL=
# Only for Flight Control (MSSP) parent/child setups
FALCON_MEMBER_CID=

# --- Ingestion ---
INGEST_ENABLED=true
INGEST_INTERVAL_SECONDS=60
INGEST_LOOKBACK_HOURS=24
INGEST_BATCH_SIZE=500

# --- Anthropic Claude (Phase 3: AI triage) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Email notifications (Phase 5) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=aisoc@example.com
ALERT_EMAIL_TO=

